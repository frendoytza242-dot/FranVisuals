			body {
				margin: 0;
				background: var(--bg);
				color: var(--text);
				font-family: var(--font-body);
				line-height: 1.5;
				overflow-x: hidden;
				transition: background 0.35s ease, color 0.35s ease;
			}

			a { color: inherit; }

			.skip-link {
				position: absolute;
				left: -9999px;
				top: 0;
				z-index: 100;
				background: var(--accent);
				color: var(--on-accent);
				padding: 0.7rem 1.1rem;
				font-weight: 700;
				text-decoration: none;
			}
			.skip-link:focus { left: 0.75rem; top: 0.75rem; }

			/* --- Logo -------------------------------------------------------- */
			.wordmark {
				display: inline-flex;
				align-items: center;
				gap: 0.6rem;
				text-decoration: none;
				color: var(--text);
			}
			.wordmark-mark {
				display: block;
				width: 2.3rem;
				height: 1.5rem;
				background: var(--logo);
				-webkit-mask-image: var(--logo-src);
				mask-image: var(--logo-src);
				-webkit-mask-repeat: no-repeat;
				mask-repeat: no-repeat;
				-webkit-mask-size: contain;
				mask-size: contain;
				-webkit-mask-position: center;
				mask-position: center;
				transition: background 0.35s ease;
			}
			.wordmark-text {
				font-family: var(--font-display);
				font-size: 1.6rem;
				letter-spacing: 0.03em;
				line-height: 1;
			}
			.wordmark-text span { color: var(--accent); }
			.wordmark.small .wordmark-text { font-size: 1.3rem; }

			/* --- Header ------------------------------------------------------ */
			.site-header {
				position: sticky;
				top: 0;
				z-index: 40;
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 1rem;
				padding: 0.95rem clamp(1rem, 4vw, 3rem);
				background: color-mix(in srgb, var(--bg) 78%, transparent);
				backdrop-filter: blur(12px);
				border-bottom: 1px solid var(--border);
			}

			.header-actions { display: flex; align-items: center; gap: 0.6rem; }

			.icon-link {
				display: grid;
				place-items: center;
				width: 2.2rem;
				height: 2.2rem;
				border: 1px solid var(--border);
				color: var(--text-dim);
				text-decoration: none;
				clip-path: polygon(0 0, calc(100% - 7px) 0, 100% 7px, 100% 100%, 7px 100%, 0 calc(100% - 7px));
				transition: border-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
			}
			.icon-link:hover, .icon-link:focus-visible { color: var(--accent); border-color: var(--accent); transform: translateY(-1px); }

			/* Scoped to the header so it outranks the later `.btn { display }` rule;
			   a bare `.header-cta` ties on specificity and loses on source order. */
			@media (max-width: 560px) {
				.site-header .header-cta { display: none; }
			}

			/* --- Theme toggle ------------------------------------------------ */
			.theme-toggle {
				border: 0;
				background: none;
				padding: 0;
				cursor: pointer;
				line-height: 0;
			}
			.theme-toggle-track {
				position: relative;
				display: inline-flex;
				align-items: center;
				justify-content: space-between;
				width: 3.9rem;
				height: 2.2rem;
				padding: 0 0.5rem;
				border: 1px solid var(--border);
				background: var(--bg-elevated);
				clip-path: polygon(0 0, calc(100% - 8px) 0, 100% 8px, 100% 100%, 8px 100%, 0 calc(100% - 8px));
				transition: border-color 0.25s ease, background 0.35s ease;
			}
			.theme-toggle:hover .theme-toggle-track { border-color: var(--accent); }
			.theme-toggle:focus-visible .theme-toggle-track { outline: 2px solid var(--accent); outline-offset: 3px; }
			.theme-icon { position: relative; z-index: 2; transition: color 0.3s ease, opacity 0.3s ease; }
			.theme-icon-sun { color: var(--text-dim); opacity: 0.5; }
			.theme-icon-moon { color: var(--on-accent); opacity: 1; }
			:root[data-theme='light'] .theme-icon-sun { color: var(--on-accent); opacity: 1; }
			:root[data-theme='light'] .theme-icon-moon { color: var(--text-dim); opacity: 0.5; }
			.theme-toggle-knob {
				position: absolute;
				top: 50%;
				left: 0.22rem;
				width: 1.6rem;
				height: 1.6rem;
				margin-top: -0.8rem;
				background: var(--accent);
				box-shadow: 0 0 0 0 var(--accent-glow);
				clip-path: polygon(0 0, calc(100% - 6px) 0, 100% 6px, 100% 100%, 6px 100%, 0 calc(100% - 6px));
				transform: translateX(1.68rem);
				transition: transform 0.32s cubic-bezier(0.16, 1, 0.3, 1), background 0.3s ease, box-shadow 0.3s ease;
			}
			:root[data-theme='light'] .theme-toggle-knob { transform: translateX(0); }
			.theme-toggle:hover .theme-toggle-knob { box-shadow: 0 0 0 5px var(--accent-glow); }
			@media (prefers-reduced-motion: reduce) {
				.theme-toggle-knob { transition: none; }
			}

			/* --- Buttons ----------------------------------------------------- */
			.btn {
				display: inline-flex;
				align-items: center;
				gap: 0.55rem;
				font-family: var(--font-body);
				font-weight: 700;
				font-size: 0.92rem;
				letter-spacing: 0.02em;
				text-decoration: none;
				padding: 0.72rem 1.25rem;
				border: 1px solid transparent;
				white-space: nowrap;
				cursor: pointer;
				clip-path: polygon(0 0, calc(100% - 10px) 0, 100% 10px, 100% 100%, 10px 100%, 0 calc(100% - 10px));
				transition: transform 0.18s ease, background 0.18s ease, border-color 0.18s ease, color 0.18s ease;
			}
			.btn-primary { background: var(--accent); color: var(--on-accent); }
			.btn-primary:hover, .btn-primary:focus-visible { background: var(--accent-bright); transform: translateY(-2px); }
			.btn-ghost { border-color: var(--border-strong); color: var(--text); }
			.btn-ghost:hover, .btn-ghost:focus-visible { border-color: var(--accent); color: var(--accent); }
			.btn-lg { padding: 1rem 1.8rem; font-size: 1.05rem; }
			.btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }

			/* --- Live pill --------------------------------------------------- */
			.pill-live {
				display: inline-flex;
				align-items: center;
				gap: 0.5rem;
				font-size: 0.76rem;
				font-weight: 700;
				letter-spacing: 0.09em;
				text-transform: uppercase;
				color: var(--text-dim);
				border: 1px solid var(--border-strong);
				padding: 0.42rem 0.85rem 0.42rem 0.65rem;
				margin: 0 0 1.5rem;
				clip-path: polygon(0 0, calc(100% - 8px) 0, 100% 8px, 100% 100%, 8px 100%, 0 calc(100% - 8px));
			}
			.dot {
				width: 0.5rem;
				height: 0.5rem;
				border-radius: 50%;
				background: var(--available);
				animation: pulse 1.9s infinite;
			}
			@media (prefers-reduced-motion: reduce) { .dot { animation: none; } }
			@keyframes pulse {
				0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--available) 55%, transparent); }
				70% { box-shadow: 0 0 0 8px transparent; }
				100% { box-shadow: 0 0 0 0 transparent; }
			}

			/* --- Hero -------------------------------------------------------- */
			.hero {
				position: relative;
				padding: clamp(3rem, 8vw, 5.5rem) clamp(1.25rem, 4vw, 3rem) clamp(2.5rem, 6vw, 4rem);
				overflow: hidden;
			}
			.hero-shards { position: absolute; inset: 0; pointer-events: none; }
			.shard {
				position: absolute;
				display: block;
				border-top: 1px solid var(--shard);
				transform-origin: left center;
			}
			.shard-1 { top: 14%; left: -10%; width: 70%; transform: rotate(-14deg); }
			.shard-2 { top: 42%; right: -14%; width: 62%; transform: rotate(-14deg); border-top-width: 2px; }
			.shard-3 { bottom: 12%; left: -6%; width: 52%; transform: rotate(-14deg); }
			.hero::after {
				content: '';
				position: absolute;
				inset: 0;
				background: radial-gradient(ellipse 70% 55% at 50% 0%, var(--accent-glow), transparent 70%);
				pointer-events: none;
			}

			.hero-inner {
				position: relative;
				z-index: 1;
				max-width: 52rem;
				margin: 0 auto;
				text-align: center;
				display: flex;
				flex-direction: column;
				align-items: center;
			}

			.hero-mark {
				display: block;
				width: clamp(4.5rem, 10vw, 6.5rem);
				height: clamp(2.9rem, 6.5vw, 4.2rem);
				margin-bottom: 1.5rem;
				background: var(--logo);
				-webkit-mask-image: var(--logo-src);
				mask-image: var(--logo-src);
				-webkit-mask-repeat: no-repeat;
				mask-repeat: no-repeat;
				-webkit-mask-size: contain;
				mask-size: contain;
				-webkit-mask-position: center;
				mask-position: center;
				transition: background 0.35s ease;
			}

			.hero-title {
				font-family: var(--font-display);
				font-size: clamp(2.8rem, 8.5vw, 6rem);
				line-height: 0.94;
				letter-spacing: 0.01em;
				margin: 0 0 1.3rem;
				text-transform: uppercase;
			}
			.accent { color: var(--accent); }

			.hero-sub {
				max-width: 36rem;
				color: var(--text-dim);
				font-size: clamp(1rem, 1.5vw, 1.12rem);
				margin: 0 auto 2.2rem;
			}

			.hero-actions {
				display: flex;
				flex-wrap: wrap;
				gap: 0.9rem;
				justify-content: center;
				margin-bottom: 3rem;
			}

			/* --- Stat band --------------------------------------------------- */
			.statband {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				justify-content: center;
				gap: clamp(1.25rem, 4vw, 3rem);
				width: 100%;
				padding-top: 2rem;
				border-top: 1px solid var(--border);
			}
			.stat-lead {
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 0.15rem;
			}
			.stat-lead-num {
				font-family: var(--font-display);
				font-size: clamp(3.2rem, 8vw, 4.6rem);
				line-height: 0.9;
				color: var(--accent);
				letter-spacing: 0.01em;
			}
			.stat-lead-label {
				font-size: 0.72rem;
				font-weight: 700;
				letter-spacing: 0.12em;
				text-transform: uppercase;
				color: var(--text-dim);
			}
			.stat-rest {
				display: flex;
				flex-wrap: wrap;
				justify-content: center;
				align-items: stretch;
				gap: 0;
				margin: 0;
				padding: 0;
				list-style: none;
			}
			.stat-rest li {
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				gap: 0.1rem;
				padding: 0 clamp(0.9rem, 3vw, 1.6rem);
				border-left: 1px solid var(--border);
			}
			.stat-rest li:first-child { border-left: 0; }
			.stat-rest .n {
				font-family: var(--font-display);
				font-size: 1.75rem;
				line-height: 1;
				color: var(--text);
			}
			.stat-rest .l {
				font-size: 0.66rem;
				font-weight: 600;
				letter-spacing: 0.09em;
				text-transform: uppercase;
				color: var(--text-dim);
				text-align: center;
			}

			/* --- Carousel ---------------------------------------------------- */
			.showcase { padding: 0 clamp(1rem, 4vw, 3rem) clamp(2.5rem, 6vw, 4rem); }
			.showcase-head { max-width: 78rem; margin: 0 auto 1.4rem; text-align: center; }
			.showcase-head h2 {
				font-family: var(--font-display);
				font-size: clamp(2.2rem, 5vw, 3.4rem);
				line-height: 1;
				text-transform: uppercase;
				letter-spacing: 0.01em;
				margin: 0 0 0.35rem;
			}
			.showcase-head p {
				display: inline-flex;
				align-items: center;
				gap: 0.5rem;
				margin: 0;
				color: var(--text-dim);
				font-size: 0.84rem;
				font-weight: 600;
				letter-spacing: 0.04em;
			}
			.showcase-head p::before,
			.showcase-head p::after {
				content: '';
				width: 1.4rem;
				height: 1px;
				background: var(--border-strong);
			}

			.carousel { max-width: 78rem; margin: 0 auto; }
			.carousel-stage {
				position: relative;
				width: 100%;
				aspect-ratio: 16 / 7.4;
				overflow: hidden;
				cursor: grab;
				touch-action: pan-y;
			}
			.carousel-stage:active { cursor: grabbing; }
			.carousel-stage:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
			.carousel-stage img { user-select: none; -webkit-user-drag: none; }
			.slide {
				position: absolute;
				top: 50%;
				left: 50%;
				width: 64%;
				margin: 0;
				aspect-ratio: 16 / 9;
				overflow: hidden;
				background: var(--panel);
				border: 1px solid var(--border);
				opacity: 0;
				pointer-events: none;
				transform: translate(-50%, -50%) scale(0.8);
				clip-path: polygon(0 0, calc(100% - 18px) 0, 100% 18px, 100% 100%, 18px 100%, 0 calc(100% - 18px));
				transition: transform 0.75s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.6s ease, filter 0.6s ease;
				z-index: 1;
			}
			.slide img { display: block; width: 100%; height: 100%; object-fit: cover; }
			.slide.is-current {
				opacity: 1;
				pointer-events: auto;
				transform: translate(-50%, -50%) scale(1);
				border-color: var(--border-strong);
				z-index: 3;
			}
			.slide.is-prev,
			.slide.is-next {
				opacity: 0.45;
				filter: blur(2px) saturate(0.7);
				z-index: 2;
			}
			.slide.is-prev { transform: translate(-50%, -50%) translateX(-64%) rotate(-6deg) scale(0.78); }
			.slide.is-next { transform: translate(-50%, -50%) translateX(64%) rotate(6deg) scale(0.78); }
			.slide figcaption {
				position: absolute;
				left: 0;
				right: 0;
				bottom: 0;
				display: flex;
				align-items: center;
				gap: 0.6rem;
				padding: 0.85rem 1rem;
				background: var(--caption-veil);
				opacity: 0;
				transition: opacity 0.4s ease;
			}
			.slide.is-current figcaption { opacity: 1; }
			.slide figcaption .title { color: #f4f9ff; }
			@media (prefers-reduced-motion: reduce) {
				.slide { transition: opacity 0.2s ease; }
			}
			@media (max-width: 720px) {
				.carousel-stage { aspect-ratio: 16 / 10; }
				.slide { width: 78%; }
				.slide.is-prev { transform: translate(-50%, -50%) translateX(-58%) rotate(-5deg) scale(0.74); }
				.slide.is-next { transform: translate(-50%, -50%) translateX(58%) rotate(5deg) scale(0.74); }
			}

			.carousel-controls {
				display: flex;
				align-items: center;
				justify-content: center;
				gap: 1rem;
				margin-top: 1.1rem;
			}
			.carousel-arrow {
				display: grid;
				place-items: center;
				width: 2.3rem;
				height: 2.3rem;
				border: 1px solid var(--border);
				background: transparent;
				color: var(--text-dim);
				cursor: pointer;
				clip-path: polygon(0 0, calc(100% - 7px) 0, 100% 7px, 100% 100%, 7px 100%, 0 calc(100% - 7px));
				transition: color 0.2s ease, border-color 0.2s ease;
			}
			.carousel-arrow:hover, .carousel-arrow:focus-visible { color: var(--accent); border-color: var(--accent); }
			.carousel-arrow:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
			.carousel-dots { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.4rem; }
			/* Twelve full-width bars outrun a phone, which shoved the arrows off
			   screen; below this width the dots take their own wrapping row. */
			@media (max-width: 720px) {
				.carousel-controls { flex-wrap: wrap; gap: 0.5rem 1rem; }
				.carousel-dots { order: 3; width: 100%; }
				.carousel-dot { width: 1.1rem; }
			}
			.carousel-dot {
				width: 1.5rem;
				height: 3px;
				padding: 0;
				border: 0;
				background: var(--border-strong);
				cursor: pointer;
				transition: background 0.25s ease, transform 0.25s ease;
			}
			.carousel-dot:hover { background: var(--text-dim); }
			.carousel-dot.is-active { background: var(--accent); transform: scaleY(1.8); }
			.carousel-dot:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }

			/* --- Ticker ------------------------------------------------------ */
			.ticker {
				border-top: 1px solid var(--border);
				border-bottom: 1px solid var(--border);
				background: var(--bg-elevated);
				overflow: hidden;
				padding: 0.8rem 0;
			}
			/* Two identical groups, each carrying its own trailing gap, so
			   translating the viewport by exactly -50% lands seamlessly. */
			.ticker-viewport {
				display: flex;
				width: max-content;
				animation: ticker-scroll 34s linear infinite;
			}
			.ticker-group { display: flex; flex-shrink: 0; }
			.ticker-item {
				display: inline-flex;
				align-items: center;
				gap: 0.7rem;
				padding-right: 2.75rem;
				font-family: var(--font-display);
				font-size: 1.05rem;
				letter-spacing: 0.06em;
				color: var(--text-dim);
				white-space: nowrap;
			}
			.ticker-item::before {
				content: '';
				width: 0.42rem;
				height: 0.42rem;
				background: var(--accent);
				transform: rotate(45deg);
				flex-shrink: 0;
			}
			.ticker:hover .ticker-viewport { animation-play-state: paused; }
			@keyframes ticker-scroll {
				from { transform: translateX(0); }
				to { transform: translateX(-50%); }
			}
			@media (prefers-reduced-motion: reduce) {
				.ticker-viewport { animation: none; width: 100%; justify-content: center; }
				.ticker-group:last-child { display: none; }
				.ticker-group { flex-wrap: wrap; justify-content: center; row-gap: 0.4rem; }
			}

			/* --- Gallery ----------------------------------------------------- */
			.gallery { padding: clamp(3rem, 8vw, 5.5rem) clamp(1.25rem, 4vw, 3rem); }
			.gallery-head h2, .cta h2 {
				font-family: var(--font-display);
				font-size: clamp(2.2rem, 5vw, 3.4rem);
				line-height: 1;
				text-transform: uppercase;
				margin: 0 0 0.5rem;
				letter-spacing: 0.01em;
			}
			.gallery-head p { color: var(--text-dim); margin: 0 0 2rem; }

			.filters { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-bottom: 2.4rem; }
			.filter {
				font-family: var(--font-body);
				font-weight: 700;
				font-size: 0.85rem;
				letter-spacing: 0.02em;
				background: transparent;
				color: var(--text-dim);
				border: 1px solid var(--border-strong);
				padding: 0.55rem 1rem;
				cursor: pointer;
				display: inline-flex;
				gap: 0.45rem;
				align-items: center;
				clip-path: polygon(0 0, calc(100% - 8px) 0, 100% 8px, 100% 100%, 8px 100%, 0 calc(100% - 8px));
				transition: border-color 0.2s ease, color 0.2s ease, background 0.2s ease;
			}
			.filter span { opacity: 0.7; font-weight: 500; }
			.filter:hover, .filter:focus-visible { color: var(--text); }
			.filter:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
			.filter.is-active { background: var(--accent); color: var(--on-accent); border-color: var(--accent); }
			.filter.is-active span { opacity: 0.75; }

			.grid { columns: 4 16rem; column-gap: 1.1rem; }
			@media (max-width: 720px) { .grid { columns: 2 12rem; } }

			.card {
				position: relative;
				margin: 0 0 1.1rem;
				break-inside: avoid;
				border: 1px solid var(--border);
				background: var(--panel);
				overflow: hidden;
				clip-path: polygon(0 0, calc(100% - 14px) 0, 100% 14px, 100% 100%, 14px 100%, 0 calc(100% - 14px));
				transition: border-color 0.25s ease, transform 0.35s ease;
			}
			.card.is-hidden { display: none; }
			.card img { display: block; width: 100%; height: auto; }
			.card:hover, .card:focus-within { border-color: var(--border-strong); transform: translateY(-3px); }

			.corner {
				position: absolute;
				width: 1.1rem;
				height: 1.1rem;
				border-color: var(--accent);
				opacity: 0;
				transition: opacity 0.25s ease;
				z-index: 2;
				pointer-events: none;
			}
			.corner-tl { top: 0.5rem; left: 0.5rem; border-top: 2px solid; border-left: 2px solid; }
			.corner-tr { top: 0.5rem; right: 0.5rem; border-top: 2px solid; border-right: 2px solid; }
			.corner-bl { bottom: 0.5rem; left: 0.5rem; border-bottom: 2px solid; border-left: 2px solid; }
			.corner-br { bottom: 0.5rem; right: 0.5rem; border-bottom: 2px solid; border-right: 2px solid; }
			.card:hover .corner, .card:focus-within .corner { opacity: 1; }

			.card figcaption {
				position: absolute;
				left: 0;
				right: 0;
				bottom: 0;
				display: flex;
				align-items: center;
				gap: 0.6rem;
				padding: 0.75rem 0.9rem;
				background: var(--caption-veil);
				transform: translateY(15%);
				opacity: 0;
				transition: transform 0.25s ease, opacity 0.25s ease;
			}
			.card:hover figcaption, .card:focus-within figcaption { transform: translateY(0); opacity: 1; }
			.card figcaption .title { color: #f4f9ff; }
			@media (hover: none) {
				.card figcaption { transform: translateY(0); opacity: 1; }
				.corner { opacity: 1; }
			}

			.tag {
				font-size: 0.64rem;
				font-weight: 800;
				letter-spacing: 0.07em;
				text-transform: uppercase;
				color: var(--on-accent);
				background: var(--accent);
				padding: 0.2rem 0.42rem;
				flex-shrink: 0;
			}
			figcaption .title {
				font-size: 0.8rem;
				font-weight: 600;
				overflow: hidden;
				text-overflow: ellipsis;
				white-space: nowrap;
			}

			/* --- Card zoom affordance ---------------------------------------- */
			.sr-only {
				position: absolute;
				width: 1px; height: 1px;
				padding: 0; margin: -1px;
				overflow: hidden;
				clip: rect(0 0 0 0);
				white-space: nowrap;
				border: 0;
			}
			.card-open {
				position: absolute;
				inset: 0;
				width: 100%;
				border: 0;
				padding: 0;
				background: transparent;
				cursor: zoom-in;
				z-index: 3;
			}
			.card-open:focus-visible { outline: 2px solid var(--accent); outline-offset: -4px; }
			.card-zoom {
				position: absolute;
				top: 0.6rem;
				right: 0.6rem;
				display: grid;
				place-items: center;
				width: 2rem;
				height: 2rem;
				color: var(--on-accent);
				background: var(--accent);
				clip-path: polygon(0 0, calc(100% - 6px) 0, 100% 6px, 100% 100%, 6px 100%, 0 calc(100% - 6px));
				opacity: 0;
				transform: translateY(-4px);
				transition: opacity 0.25s ease, transform 0.25s ease;
			}
			.card:hover .card-zoom,
			.card-open:focus-visible .card-zoom { opacity: 1; transform: translateY(0); }
			@media (hover: none) { .card-zoom { opacity: 1; transform: translateY(0); } }

			/* --- Lightbox ----------------------------------------------------- */
			.lightbox {
				position: fixed;
				inset: 0;
				z-index: 90;
				display: grid;
				place-items: center;
				padding: clamp(1rem, 4vw, 3rem);
			}
			.lightbox[hidden] { display: none; }
			.lightbox-scrim {
				position: absolute;
				inset: 0;
				background: rgba(2, 6, 12, 0.86);
				backdrop-filter: blur(6px);
				opacity: 0;
				transition: opacity 0.22s ease;
			}
			.lightbox.is-open .lightbox-scrim { opacity: 1; }
			.lightbox-panel {
				position: relative;
				max-width: min(78rem, 100%);
				max-height: 100%;
				opacity: 0;
				transform: scale(0.97);
				transition: opacity 0.22s ease, transform 0.28s cubic-bezier(0.16, 1, 0.3, 1);
			}
			.lightbox.is-open .lightbox-panel { opacity: 1; transform: scale(1); }
			.lightbox-figure {
				margin: 0;
				background: var(--panel);
				border: 1px solid var(--border-strong);
				clip-path: polygon(0 0, calc(100% - 20px) 0, 100% 20px, 100% 100%, 20px 100%, 0 calc(100% - 20px));
			}
			.lightbox-media { display: flex; justify-content: center; }
			.lightbox-media img {
				display: block;
				max-width: 100%;
				max-height: calc(100vh - 12rem);
				width: auto;
			}
			.lightbox-caption {
				display: flex;
				align-items: center;
				gap: 0.7rem;
				padding: 0.85rem 1.1rem;
				border-top: 1px solid var(--border);
				background: var(--bg-elevated);
			}
			.lightbox-title {
				font-size: 0.9rem;
				font-weight: 600;
				color: var(--text);
				overflow: hidden;
				text-overflow: ellipsis;
				white-space: nowrap;
			}
			.lightbox-counter {
				margin-left: auto;
				flex-shrink: 0;
				font-family: var(--font-display);
				font-size: 1rem;
				letter-spacing: 0.06em;
				color: var(--text-dim);
			}
			.lightbox-btn {
				position: absolute;
				display: grid;
				place-items: center;
				width: 2.6rem;
				height: 2.6rem;
				border: 1px solid var(--border-strong);
				background: var(--bg-elevated);
				color: var(--text);
				cursor: pointer;
				clip-path: polygon(0 0, calc(100% - 8px) 0, 100% 8px, 100% 100%, 8px 100%, 0 calc(100% - 8px));
				transition: color 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
			}
			.lightbox-btn:hover { color: var(--accent); border-color: var(--accent); }
			.lightbox-btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
			.lightbox-close { top: -1.3rem; right: -1.3rem; }
			.lightbox-prev { left: -1.3rem; top: 50%; margin-top: -3rem; }
			.lightbox-next { right: -1.3rem; top: 50%; margin-top: -3rem; }
			.lightbox-prev:hover { transform: translateX(-2px); }
			.lightbox-next:hover { transform: translateX(2px); }
			/* Below this width there is no room outside the panel, so the controls
			   move inside and overlay the image instead of hanging off the edge. */
			@media (max-width: 860px) {
				.lightbox-btn {
					width: 2.4rem;
					height: 2.4rem;
					background: color-mix(in srgb, var(--bg-elevated) 88%, transparent);
					backdrop-filter: blur(4px);
				}
				.lightbox-close { top: 0.55rem; right: 0.55rem; }
				.lightbox-prev { left: 0.55rem; top: 40%; margin-top: -1.2rem; }
				.lightbox-next { right: 0.55rem; top: 40%; margin-top: -1.2rem; }
				.lightbox-prev:hover, .lightbox-next:hover { transform: none; }
				.lightbox-counter { display: none; }
				.lightbox-media img { max-height: calc(100vh - 9rem); }
			}
			@media (prefers-reduced-motion: reduce) {
				.lightbox-scrim, .lightbox-panel { transition: none; }
			}

			/* --- Closing CTA -------------------------------------------------- */
			.cta {
				text-align: center;
				padding: clamp(4rem, 10vw, 7rem) 1.5rem;
				border-top: 1px solid var(--border);
				background: radial-gradient(ellipse 60% 70% at 50% 0%, var(--accent-glow), transparent 65%);
			}
			.cta h2 { margin-bottom: 2.2rem; }

			/* --- Footer ------------------------------------------------------- */
			.site-footer {
				position: relative;
				padding: clamp(2.5rem, 6vw, 3.5rem) clamp(1.25rem, 4vw, 3rem);
				border-top: 1px solid var(--border);
				background: var(--bg-elevated);
				overflow: hidden;
			}
			.footer-mark {
				position: absolute;
				right: -3%;
				bottom: -32%;
				width: min(30rem, 62vw);
				height: min(19.5rem, 40vw);
				background: var(--logo);
				opacity: 0.06;
				-webkit-mask-image: var(--logo-src);
				mask-image: var(--logo-src);
				-webkit-mask-repeat: no-repeat;
				mask-repeat: no-repeat;
				-webkit-mask-size: contain;
				mask-size: contain;
				pointer-events: none;
			}
			.footer-inner {
				position: relative;
				z-index: 1;
				display: grid;
				grid-template-columns: minmax(15rem, 1.6fr) repeat(3, minmax(9rem, 1fr));
				gap: clamp(1.75rem, 4vw, 3rem);
				max-width: 78rem;
				margin: 0 auto;
			}
			@media (max-width: 900px) {
				.footer-inner { grid-template-columns: repeat(2, minmax(0, 1fr)); }
				.footer-brand { grid-column: 1 / -1; }
			}
			@media (max-width: 520px) {
				.footer-inner { grid-template-columns: minmax(0, 1fr); }
			}

			.footer-brand { max-width: 24rem; }
			.footer-tagline {
				margin: 0.9rem 0 1.1rem;
				color: var(--text-dim);
				font-size: 0.9rem;
				line-height: 1.6;
			}
			.footer-pill { margin: 0; font-size: 0.7rem; }

			.footer-col h3 {
				margin: 0 0 0.9rem;
				font-size: 0.7rem;
				font-weight: 700;
				letter-spacing: 0.13em;
				text-transform: uppercase;
				color: var(--text);
			}
			.footer-col ul { margin: 0; padding: 0; list-style: none; display: grid; gap: 0.55rem; }
			/* :not(.btn) matters — a bare `.footer-col a` outranks `.btn-primary` on
			   specificity and was repainting the contact button's label dim. */
			.footer-col a:not(.btn) {
				display: inline-block;
				color: var(--text-dim);
				text-decoration: none;
				font-size: 0.88rem;
				transition: color 0.2s ease, transform 0.2s ease;
			}
			.footer-col a:not(.btn):hover,
			.footer-col a:not(.btn):focus-visible { color: var(--accent); transform: translateX(2px); }

			.footer-social { gap: 0.75rem; }
			.footer-social a { display: flex; align-items: center; gap: 0.7rem; }
			.social-badge {
				display: grid;
				place-items: center;
				width: 2.1rem;
				height: 2.1rem;
				flex-shrink: 0;
				color: var(--text);
				border: 1px solid var(--border-strong);
				clip-path: polygon(0 0, calc(100% - 7px) 0, 100% 7px, 100% 100%, 7px 100%, 0 calc(100% - 7px));
				transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease;
			}
			.footer-social a:hover .social-badge,
			.footer-social a:focus-visible .social-badge {
				color: var(--on-accent);
				background: var(--accent);
				border-color: var(--accent);
			}
			.social-label { display: flex; flex-direction: column; line-height: 1.25; }
			.social-label em {
				font-style: normal;
				font-size: 0.76rem;
				color: var(--text-dim);
			}

			.footer-btn {
				font-size: 0.9rem;
				padding: 0.7rem 1.05rem;
				color: var(--on-accent);
			}
			.footer-note { margin: 0.8rem 0 0; color: var(--text-dim); font-size: 0.76rem; }

			.footer-bar {
				position: relative;
				z-index: 1;
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem 1.5rem;
				justify-content: space-between;
				max-width: 78rem;
				margin: clamp(2rem, 5vw, 3rem) auto 0;
				padding-top: 1.3rem;
				border-top: 1px solid var(--border);
			}
			.footer-bar p { margin: 0; color: var(--text-dim); font-size: 0.78rem; }
		</style>
	</body>
</html>
