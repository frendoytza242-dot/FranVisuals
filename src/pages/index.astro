				--accent: #0b6fa8;
				--accent-bright: #095b8b;
				--accent-glow: rgba(11, 111, 168, 0.16);
				--on-accent: #ffffff;
				--logo: #0d1b33;
				--available: #0f9d4f;
				--caption-veil: linear-gradient(to top, rgba(10, 18, 32, 0.9), rgba(10, 18, 32, 0));
				--shard: rgba(13, 27, 51, 0.14);
			}

			:root {
				--font-display: 'Bebas Neue', 'Archivo', sans-serif;
				--font-body: 'Archivo', system-ui, sans-serif;
